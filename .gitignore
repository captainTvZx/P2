# Cargo derleme çıktısı. Varsayılan hedef klasörü OneDrive dışında (.cargo/config.toml →
# C:/p2-rust-target); CARGO_TARGET_DIR=target ile derlenirse burada oluşur.
/target

# Paket çıktıları
/dist/
release/
release-package/
release-rust-*/

# Yerel veri, yedekler, günlükler
backups/
.p2-data/
.server-service/
db-backup-*.json
*.log
.env

# Overlay DLL + enjektör (CMake); packaging/build-overlay.mjs üretir
native/**/build/
native/overlay/dist/

# Eski Node araçları diskte kalabilir; hiçbir şey onlara bağlı değil
node_modules/
%TEMP%/
