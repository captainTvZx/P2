generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

enum UserRole {
  USER
  ADMIN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  TESTER
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectChannelType {
  TEXT
  ANNOUNCEMENT
  VOICE
  FORUM
}

model User {
  id                      String                @id @default(uuid())
  email                   String                @unique
  username                String                @unique
  displayName             String
  passwordHash            String
  status                  UserStatus            @default(OFFLINE)
  statusPreference        String                @default("ONLINE")
  twoFactorSecret         String?
  twoFactorEnabled        Boolean               @default(false)
  title                   String?
  avatarUrl               String?
  lastClientVersion       String?
  lastClientSeenAt        DateTime?
  role                    UserRole              @default(USER)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  sessions                Session[]
  sentFriendships         Friendship[]          @relation("FriendshipRequester")
  receivedFriendships     Friendship[]          @relation("FriendshipAddressee")
  ownedProjects           Project[]             @relation("ProjectOwner")
  assignedTasks           Task[]                @relation("TaskAssignee")
  createdTasks            Task[]                @relation("TaskAuthor")
  createdSprints          Sprint[]              @relation("SprintAuthor")
  createdBoards           Board[]               @relation("BoardAuthor")
  taskComments            TaskComment[]         @relation("TaskCommentAuthor")
  taskCommentReactions    TaskCommentReaction[] @relation("TaskCommentReactor")
  memberships             ProjectMember[]
  organizationMemberships OrganizationMember[]
  createdInvites          OrganizationInvite[]  @relation("InviteCreator")
  channelMessages         ChannelMessage[]
  messageReactions        MessageReaction[]
  directConversationsA    DirectConversation[]  @relation("DirectUserA")
  directConversationsB    DirectConversation[]  @relation("DirectUserB")
  directMessages          DirectMessage[]
  preferences             UserPreference[]
  groupMemberships        ChatGroupMember[]
  activities              Activity[]            @relation("ActivityOwner")
  actedActivities         Activity[]            @relation("ActivityActor")
  groupMessages           ChatGroupMessage[]
  chatReactions           ChatReaction[]
  userGroupMemberships    UserGroupMember[]
  createdUserGroups       UserGroup[]           @relation("UserGroupCreator")
  roleMemberships         RoleMember[]
  createdRoles            Role[]                @relation("RoleCreator")
  ownedDocuments          ProjectDocument[]     @relation("DocumentOwner")
  documentPermissions     DocumentPermission[]  @relation("DocumentPermissionUser")
  channelReads            ChannelRead[]
}

// Gruplar: @devs, @art gibi etiketlenebilir kişi kümeleri. Yetki taşımazlar;
// yetki rollerden gelir, ama bir gruba rol atanabilir (RoleGroup).
model UserGroup {
  id             String            @id @default(uuid())
  organizationId String
  handle         String
  name           String
  description    String?
  color          String?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("UserGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members        UserGroupMember[]
  roles          RoleGroup[]

  @@unique([organizationId, handle])
  @@index([organizationId])
}

model UserGroupMember {
  groupId String
  userId  String
  addedAt DateTime  @default(now())
  group   UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// Roller: yetki kümeleri. Kişiye ve gruba atanır. Her kuruluşta silinemeyen iki
// temel rol vardır: kurucu (tüm yetkiler, sahibe ait) ve herkes (standart).
model Role {
  id             String       @id @default(uuid())
  organizationId String
  handle         String
  name           String
  description    String?
  color          String?
  everyone       Boolean      @default(false)
  founder        Boolean      @default(false)
  permissions    String[]     @default([])
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("RoleCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members        RoleMember[]
  groups         RoleGroup[]

  @@unique([organizationId, handle])
  @@index([organizationId])
}

model RoleMember {
  roleId  String
  userId  String
  addedAt DateTime @default(now())
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roleId, userId])
  @@index([userId])
}

model RoleGroup {
  roleId  String
  groupId String
  addedAt DateTime  @default(now())
  role    Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  group   UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([roleId, groupId])
  @@index([groupId])
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  members             OrganizationMember[]
  invites             OrganizationInvite[]
  projects            Project[]
  directConversations DirectConversation[]
  preferences         UserPreference[]
  groups              ChatGroup[]
  userGroups          UserGroup[]
  roles               Role[]
  activities          Activity[]
  boards              Board[]
  sprints             Sprint[]
  tasks               Task[]
}

model OrganizationMember {
  organizationId    String
  userId            String
  role              OrganizationRole @default(MEMBER)
  permissions       String[]         @default([]) // role üstüne eklenen yetkiler
  deniedPermissions String[]         @default([]) // rolden/gruplardan gelse de kapatılanlar
  joinedAt          DateTime         @default(now())
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model OrganizationInvite {
  id             String       @id @default(uuid())
  code           String       @unique
  organizationId String
  createdById    String
  expiresAt      DateTime?
  maxUses        Int?
  useCount       Int          @default(0)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model Project {
  id                String            @id @default(uuid())
  name              String
  slug              String
  description       String?
  engine            String?
  ownerId           String
  organizationId    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  purgeAt           DateTime?
  owner             User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  organization      Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members           ProjectMember[]
  channelCategories ChannelCategory[]
  boards            Board[]
  sprints           Sprint[]
  tasks             Task[]
  chatGroups        ChatGroup[]
  documents         ProjectDocument[]
  documentFolders   ProjectDocumentFolder[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([purgeAt])
}

model ProjectDocument {
  id          String               @id @default(uuid())
  projectId   String
  ownerId     String
  folderId    String?
  title       String
  kind        String               @default("CANVAS")
  content     Json                 @default("{}")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User                 @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folder      ProjectDocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  permissions DocumentPermission[]

  @@index([projectId, updatedAt])
  @@index([ownerId])
  @@index([folderId])
}

model ProjectDocumentFolder {
  id        String            @id @default(uuid())
  projectId String
  name      String
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents ProjectDocument[]

  @@index([projectId, position])
}

model DocumentPermission {
  documentId String
  userId     String
  access     String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  document   ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User            @relation("DocumentPermissionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([userId])
}

model ChannelCategory {
  id        String           @id @default(uuid())
  name      String
  position  Int              @default(0)
  deletedAt DateTime?
  purgeAt   DateTime?
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channels  ProjectChannel[]

  @@index([projectId, position])
  @@index([purgeAt])
}

model ProjectChannel {
  id                  String              @id @default(uuid())
  name                String
  topic               String?
  type                ProjectChannelType  @default(TEXT)
  position            Int                 @default(0)
  categoryId          String
  createdAt           DateTime            @default(now())
  deletedAt           DateTime?
  purgeAt             DateTime?
  category            ChannelCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  messages            ChannelMessage[]
  permissionOverrides ChannelPermission[]
  reads               ChannelRead[]

  @@index([categoryId, position])
  @@index([purgeAt])
}

// Her kullanıcının kanalı en son ne zaman gördüğünü tutar. Böylece okunmamış
// sayısı uygulama kapanıp açılsa da ve farklı cihazlarda da aynı kalır.
model ChannelRead {
  channelId  String
  userId     String
  lastReadAt DateTime @default(now())
  channel    ProjectChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

// Kanala özel izinler: rol, kullanıcı grubu ya da tek kişi için aç/kapat.
model ChannelPermission {
  id         String         @id @default(uuid())
  channelId  String
  targetType String // ROLE | GROUP | USER
  targetId   String // OWNER/ADMIN/MEMBER · kullanıcı grubu kimliği · kişi kimliği
  allow      String[]       @default([])
  deny       String[]       @default([])
  updatedAt  DateTime       @updatedAt
  channel    ProjectChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, targetType, targetId])
  @@index([channelId])
}

model ChannelMessage {
  id              String               @id @default(uuid())
  content         String
  channelId       String
  authorId        String
  parentId        String?
  quotedMessageId String?
  forwardedFromId String?
  createdAt       DateTime             @default(now())
  editedAt        DateTime?
  channel         ProjectChannel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author          User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent          ChannelMessage?      @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         ChannelMessage[]     @relation("MessageReplies")
  quotedMessage   ChannelMessage?      @relation("MessageQuotes", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotes          ChannelMessage[]     @relation("MessageQuotes")
  forwardedFrom   ChannelMessage?      @relation("MessageForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        ChannelMessage[]     @relation("MessageForwards")
  editHistory     MessageEditHistory[]
  reactions       MessageReaction[]

  @@index([channelId, createdAt])
  @@index([parentId, createdAt])
  @@index([quotedMessageId])
  @@index([forwardedFromId])
}

// Kullanıcının kanal/kişi başına tercihleri: yıldız ve bildirim ayarı
model UserPreference {
  userId         String
  organizationId String
  kind           String
  targetId       String
  starred        Boolean      @default(false)
  notify         String       @default("MENTIONS")
  hidden         Boolean      @default(false)
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, kind, targetId])
  @@index([userId, organizationId])
}

model DirectConversation {
  id              String          @id @default(uuid())
  organizationId  String
  userAId         String
  userBId         String
  userALastReadAt DateTime?
  userBLastReadAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userA           User            @relation("DirectUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB           User            @relation("DirectUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages        DirectMessage[]

  @@unique([organizationId, userAId, userBId])
  @@index([organizationId, updatedAt])
}

model DirectMessage {
  id              String             @id @default(uuid())
  conversationId  String
  authorId        String
  content         String
  kind            String             @default("TEXT")
  quotedMessageId String?
  createdAt       DateTime           @default(now())
  editedAt        DateTime?
  conversation    DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  quotedMessage   DirectMessage?     @relation("DirectQuotes", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotes          DirectMessage[]    @relation("DirectQuotes")
  reactions       ChatReaction[]

  @@index([conversationId, createdAt])
  @@index([quotedMessageId])
}

model MessageReaction {
  id        String         @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime       @default(now())
  message   ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId, createdAt])
}

model MessageEditHistory {
  id        String         @id @default(uuid())
  messageId String
  content   String
  createdAt DateTime       @default(now())
  message   ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

// Grup sohbetleri: kişiler listesinin altındaki "Gruplar" bölümü. Kanal aramasıyla
// otomatik oluşabilir ya da elle kurulabilir.
model ChatGroup {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  createdById    String
  channelId      String?
  projectId      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members        ChatGroupMember[]
  messages       ChatGroupMessage[]

  @@index([organizationId, updatedAt])
  @@index([projectId, updatedAt])
}

model ChatGroupMember {
  id         String    @id @default(uuid())
  groupId    String
  userId     String
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())
  group      ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model ChatGroupMessage {
  id              String             @id @default(uuid())
  groupId         String
  authorId        String
  content         String
  kind            String             @default("TEXT")
  quotedMessageId String?
  parentId        String?
  createdAt       DateTime           @default(now())
  editedAt        DateTime?
  group           ChatGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  quotedMessage   ChatGroupMessage?  @relation("GroupQuotes", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotes          ChatGroupMessage[] @relation("GroupQuotes")
  parent          ChatGroupMessage?  @relation("GroupThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies         ChatGroupMessage[] @relation("GroupThread")
  reactions       ChatReaction[]

  @@index([groupId, createdAt])
  @@index([quotedMessageId])
  @@index([parentId, createdAt])
}

// Bireysel ve grup mesajlarına tepkiler (kanal mesajları MessageReaction kullanır).
model ChatReaction {
  id              String            @id @default(uuid())
  directMessageId String?
  groupMessageId  String?
  userId          String
  emoji           String
  createdAt       DateTime          @default(now())
  directMessage   DirectMessage?    @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  groupMessage    ChatGroupMessage? @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([directMessageId, userId, emoji])
  @@unique([groupMessageId, userId, emoji])
  @@index([directMessageId])
  @@index([groupMessageId])
}

// Etkinlik akışı: etiketlenme, mesajına yanıt ve tepki gibi olaylar burada
// birikir; kullanıcı geçmişe dönük bakabilir ve olayın geçtiği mesaja gidebilir.
model Activity {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  actorId        String
  kind           String
  projectId      String?
  channelId      String?
  channelName    String?
  groupId        String?
  groupName      String?
  boardId        String?
  taskId         String?
  documentId     String?
  messageId      String?
  parentId       String?
  emoji          String?
  preview        String       @default("")
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("ActivityOwner", fields: [userId], references: [id], onDelete: Cascade)
  actor          User         @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([taskId])
  @@index([documentId])
}

// Görev panosu: sprint'ler ve kanban görevleri. Kuruluş düzeyinde yaşarlar,
// istenirse bir projeye bağlanır.
model Board {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  name           String
  position       Int          @default(0)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("BoardAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  sprints        Sprint[]
  tasks          Task[]

  @@index([projectId])
  @@index([organizationId])
}

model Sprint {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  boardId        String
  name           String
  goal           String?
  status         String       @default("PLANNED")
  startsAt       DateTime?
  endsAt         DateTime?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board          Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("SprintAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([organizationId])
  @@index([projectId])
  @@index([boardId])
}

model TaskCommentReaction {
  id        String      @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation("TaskCommentReactor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId, createdAt])
}

model TaskComment {
  id        String                @id @default(uuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  task      Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User                  @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reactions TaskCommentReaction[]

  @@index([taskId])
}

model Task {
  id             String        @id @default(uuid())
  organizationId String
  projectId      String
  boardId        String
  sprintId       String?
  number         Int
  title          String
  description    String?
  status         String        @default("TODO")
  priority       String        @default("MEDIUM")
  points         Int?
  position       Int           @default(0)
  assigneeId     String?
  createdById    String
  dueAt          DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board          Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  sprint         Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee       User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User          @relation("TaskAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  comments       TaskComment[]

  @@unique([projectId, number])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([boardId, status])
  @@index([sprintId])
}
