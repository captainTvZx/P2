{
  "name": "p2-desktop",
  "version": "0.9.9",
  "private": true,
  "type": "module",
  "description": "P2 Windows desktop application",
  "author": "P2 Team",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "concurrently -k \"npm:dev:web\" \"npm:dev:electron-ui\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/src/main.ts",
    "dev:electron": "wait-on http://localhost:5173 http://127.0.0.1:4000/health && node electron/run-dev.cjs",
    "dev:electron-local": "wait-on http://localhost:5173 http://127.0.0.1:4010/health && node electron/run-dev.cjs",
    "dev:electron-ui": "wait-on http://localhost:5173 && node electron/run-dev.cjs --ui-demo",
    "build:web": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:web && electron-builder --dir",
    "dist:client": "npm run build:web && electron-builder --win nsis",
    "prepare:server-service": "node scripts/prepare-server-service.mjs",
    "dist:server": "npm run build:server && npm run prepare:server-service && electron-builder --config electron-builder.server.yml --win nsis",
    "dist:server:linux": "node scripts/build-linux-server.mjs",
    "dist": "npm run build:web && npm run build:server && npm run prepare:server-service && electron-builder --win nsis && electron-builder --config electron-builder.server.yml --win nsis",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "test:server": "vitest run server/src",
    "preview": "vite preview",
    "build:native": "node-gyp rebuild --directory=native/loopback --target=44.0.0 --dist-url=https://electronjs.org/headers --arch=x64",
    "publish:update": "node scripts/publish-update.mjs",
    "test:updates": "node tests/updates.e2e.mjs",
    "test:board": "node tests/board.e2e.mjs",
    "test:update-push": "node tests/update-push.e2e.mjs",
    "test:ui": "vitest run src",
    "test:members": "node tests/member-removal.e2e.mjs",
    "test:boot": "node tests/boot.e2e.mjs",
    "test:server-console": "node tests/server-console.e2e.mjs",
    "test:backup": "node tests/server-backup.e2e.mjs",
    "test:coexist": "node tests/client-server-coexist.e2e.mjs",
    "test:purge": "node tests/project-purge.e2e.mjs",
    "test:stop": "node tests/server-stop.e2e.mjs",
    "build:overlay": "node scripts/build-overlay.mjs",
    "build:overlay-host": "node scripts/build-overlay.mjs host",
    "overlay:collect": "node scripts/collect-overlay.mjs",
    "build:overlay-dll": "node scripts/build-overlay.mjs dll"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "^6.12.0",
    "@vitejs/plugin-react": "latest",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "emoji-picker-react": "^4.19.1",
    "jszip": "^3.10.2",
    "libarchive.js": "^2.0.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "node-windows": "^1.0.0-beta.8",
    "prisma": "6.12.0",
    "tsx": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.p2.desktop",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "native/overlay/dist",
        "to": "overlay",
        "filter": [
          "*.dll",
          "*.exe",
          "*.node"
        ]
      }
    ],
    "productName": "P2 Client",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-package/client"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/server-main.cjs",
      "!electron/server-preload.cjs",
      "!electron/server-console.html",
      "!electron/server-console.css",
      "!electron/service/**/*",
      "package.json",
      "native/loopback/build/Release/*.node",
      "!native/overlay/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "P2-Client-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "P2",
      "deleteAppDataOnUninstall": true
    },
    "asarUnpack": [
      "native/loopback/build/Release/*.node"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1:4000/updates/",
        "channel": "latest"
      }
    ]
  }
}
