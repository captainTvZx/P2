{
  "name": "p2-desktop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "P2 Windows desktop application",
  "author": "P2 Team",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/src/main.ts",
    "dev:electron": "wait-on http://localhost:5173 http://127.0.0.1:4000/health && electron .",
    "build:web": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:web && npm run build:server && electron-builder --dir",
    "dist": "npm run build:web && npm run build:server && electron-builder --win nsis",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "test:server": "vitest run server/src",
    "preview": "vite preview",
    "build:native": "node-gyp rebuild --directory=native/loopback --target=44.0.0 --dist-url=https://electronjs.org/headers --arch=x64"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "6.12.0",
    "@vitejs/plugin-react": "latest",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "emoji-picker-react": "^4.19.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "prisma": "6.12.0",
    "tsx": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.p2.desktop",
    "productName": "P2",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-package"
    },
    "files": [
      "dist/**/*",
      "server/dist/**/*",
      "server/prisma/**/*",
      "electron/**/*",
      "package.json",
      "native/loopback/build/Release/*.node"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "P2-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "native/loopback/build/Release/*.node"
    ]
  }
}
